<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 框架级 gRPC 能力宿主（服务端拦截器 + AddVivGrpcServer/AddVivGrpcKestrel/AddVivGrpcClient）：依赖 ASP.NET Core 共享框架 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
    <!-- MagicOnion：第二条 RPC 通道（C# 接口 + MessagePack），与 gRPC 并存于同一 HTTP/2 端口。
         放在框架工程里是有意选择：迁移期由配置（KekeOption.GrpcOption.Protocol）决定用哪条，
         不想为 5 个文件再加一个工程；代价是每个引用 Keke 的宿主都会带上这几个包（未使用不加载）。 -->
    <PackageReference Include="MagicOnion.Server" />
    <PackageReference Include="MagicOnion.Client" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viv.Contracts\Viv.Contracts.csproj" />
    <ProjectReference Include="..\Viv.Delusion\Viv.Delusion.csproj" />
    <ProjectReference Include="..\Viv.Forge\Viv.Forge.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
