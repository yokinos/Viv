<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
	</PropertyGroup>

	<ItemGroup>
		<!-- 完整引用 ASP.NET Core 共享框架（JwtBearer/RateLimiter/OutputCache/WebSockets 均来自 Microsoft.AspNetCore.App） -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Viv.Aoi\Viv.Aoi.csproj" />
		<ProjectReference Include="..\Viv.Clockwork\Viv.Clockwork.csproj" />
		<ProjectReference Include="..\Viv.Contracts\Viv.Contracts.csproj" />
		<ProjectReference Include="..\Viv.Delusion\Viv.Delusion.csproj" />
		<ProjectReference Include="..\Viv.Momo\Viv.Momo.csproj" />
		<ProjectReference Include="..\Viv.Nana\Viv.Nana.csproj" />
		<ProjectReference Include="..\Viv.Redis\Viv.Redis.csproj" />
		<ProjectReference Include="..\Viv.Echo\Viv.Echo.csproj" />
		<ProjectReference Include="..\Viv.Sandrone\Viv.Sandrone.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Yarp.ReverseProxy" />
		<!-- .NET 10 已从共享框架移除 JwtBearer，需显式引用 -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<!-- 与服务端 JwtTokenService（Viv.Contracts 引 System.IdentityModel.Tokens.Jwt 8.22.0）对齐 IdentityModel 版本：
		     若只缓存 8.0.1 的 Protocols.OpenIdConnect，JwtBearer 的传递依赖会被钉到 8.0.1，
		     而 8.0.1 的 JsonWebTokenHandler 拒绝无 kid 的令牌（IDX10517），8.x 后续版本已修复。 -->
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Web\notfound.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="Web\welcome.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="Web\gateway.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
