<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Viv.Outbox.Tests" />
    <!-- 共享替身程序集：StubOutboxRepository 要桩 internal 的 IOutboxRepository -->
    <InternalsVisibleTo Include="Viv.Fakes" />
  </ItemGroup>

  <!-- 建表 DDL 随程序集走：投递器启动时按 provider 取对应脚本执行（幂等）。
       同目录的 .sql 也可直接交给 DBA / 迁移脚本，运行时读的就是这两个文件，不存在第二份副本。 -->
  <ItemGroup>
    <EmbeddedResource Include="Sql\OutboxMessage.sql" />
    <EmbeddedResource Include="Sql\OutboxMessage.pg.sql" />
    <EmbeddedResource Include="Sql\InboxMessage.sql" />
    <EmbeddedResource Include="Sql\InboxMessage.pg.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- 认领 SQL 要拿 UPDATE ... OUTPUT/RETURNING 回吐的行 —— IMomoDbContext 上没有
         「主库 + 返回行」的原生 SQL 方法（所有查行的方法都走读库），只能自己在那条主库连接上跑 Dapper -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- 「不许直接读墙钟」的硬约束：BannedSymbols.txt 里列出的成员编译期直接报错（RS0030）。
         投递器的退避、租约、保留期全是时间判断，散着写 UtcNow 会让这些逻辑既测不了也扛不住时钟跳变。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viv.Contracts\Viv.Contracts.csproj" />
    <ProjectReference Include="..\Viv.Delusion\Viv.Delusion.csproj" />
    <ProjectReference Include="..\Viv.Log\Viv.Log.csproj" />
    <ProjectReference Include="..\Viv.Momo\Viv.Momo.csproj" />
    <ProjectReference Include="..\Viv.Nana\Viv.Nana.csproj" />
  </ItemGroup>

</Project>
