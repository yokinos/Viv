    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extras.DynamicProxy" />
    <PackageReference Include="Castle.Core.AsyncInterceptor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Banshee\Viv.Engine\Viv.Engine.csproj" />
    <ProjectReference Include="..\..\Banshee\Viv.Clockwork\Viv.Clockwork.csproj" />
    <ProjectReference Include="..\..\Banshee\Viv.Momo\Viv.Momo.csproj" />
    <!-- 替身集中在这个程序集里，测试项目只留「被测对象 + 探针 + 测试数据」 -->
    <ProjectReference Include="..\Viv.Fakes\Viv.Fakes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>