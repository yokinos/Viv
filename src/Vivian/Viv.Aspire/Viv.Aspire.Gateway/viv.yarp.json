{
  "ReverseProxy": {
    "Clusters": {
      "apex": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7093"
          }
        }
      },
      "herta": {
        "Destinations": {
          "d1": {
            "Address": "http://viv-herta-api"
          }
        }
      },
      "hertalink": {
        "Destinations": {
          "d1": {
            "Address": "http://viv-herta-link"
          }
        }
      },
      "robin": {
        "Destinations": {
          "d1": {
            "Address": "http://viv-robin-api"
          }
        }
      },
      "deepred": {
        "Destinations": {
          "d1": {
            "Address": "http://viv-deepred-api"
          }
        }
      },
      "sakumai": {
        "Destinations": {
          "d1": {
            "Address": "http://viv-sakumai-api"
          }
        }
      }
    },
    "Routes": {
      "apex-open-route": {
        "ClusterId": "apex",
        "Match": {
          "Path": "/apex/open/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/apex/open"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "apex-route": {
        "ClusterId": "apex",
        "Match": {
          "Path": "/apex/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "PathRemovePrefix": "/apex"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "herta-open-route": {
        "ClusterId": "herta",
        "Match": {
          "Path": "/herta/open/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/herta/open"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "herta-route": {
        "ClusterId": "herta",
        "Match": {
          "Path": "/herta/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/herta"
          },
          {
            "PathPrefix": "/api"
          }
        ],
        "AuthorizationPolicy": "default"
      },
      "hertalink-open-route": {
        "ClusterId": "hertalink",
        "Match": {
          "Path": "/hertalink/open/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/hertalink/open"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "hertalink-route": {
        "ClusterId": "hertalink",
        "Match": {
          "Path": "/hertalink/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/hertalink"
          },
          {
            "PathPrefix": "/api"
          }
        ],
        "AuthorizationPolicy": "default"
      },
      "hertalink-chat-route": {
        "ClusterId": "hertalink",
        "Match": {
          "Path": "/hertalink/chat/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/hertalink"
          }
        ]
      },
      "robin-open-route": {
        "ClusterId": "robin",
        "Match": {
          "Path": "/robin/open/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/robin/open"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "robin-route": {
        "ClusterId": "robin",
        "Match": {
          "Path": "/robin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/robin"
          },
          {
            "PathPrefix": "/api"
          }
        ],
        "AuthorizationPolicy": "default"
      },

      "docs-apex-route": {
        "ClusterId": "apex",
        "Match": {
          "Path": "/docs/viv-apex-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/viv-apex-api"
          }
        ]
      },
      "docs-herta-route": {
        "ClusterId": "herta",
        "Match": {
          "Path": "/docs/viv-herta-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/viv-herta-api"
          }
        ]
      },
      "docs-hertalink-route": {
        "ClusterId": "hertalink",
        "Match": {
          "Path": "/docs/viv-herta-link/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/viv-herta-link"
          }
        ]
      },
      "docs-deepred-route": {
        "ClusterId": "deepred",
        "Match": {
          "Path": "/docs/viv-deepred-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/viv-deepred-api"
          }
        ]
      },
      "docs-sakumai-route": {
        "ClusterId": "sakumai",
        "Match": {
          "Path": "/docs/viv-sakumai-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/viv-sakumai-api"
          }
        ]
      }
    }
  }
}
