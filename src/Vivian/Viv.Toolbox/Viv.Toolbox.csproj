<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- appsettings.Development.json 被 .gitignore 忽略：本地有就复制，
       CI 全新检出时没有这个文件，不能让复制动作报 MSB3030 把整次构建打断 -->
  <ItemGroup>
    <None Remove="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Banshee\Viv.Cli\Viv.Cli.csproj" />
    <ProjectReference Include="..\..\Banshee\Viv.Engine\Viv.Engine.csproj" />
    <!-- DIOption 扫描与 EntityTypeOptions 都按程序集名找，业务程序集必须在引用图里 -->
    <ProjectReference Include="..\Viv.Apex.Core\Viv.Apex.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
